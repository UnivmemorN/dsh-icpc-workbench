{
  "name": "dsh-icpc-workbench",
  "version": "0.1.8",
  "description": "Personal ICPC training workbench plugin: normalized problems, evidence-checked tag analysis, weakness statistics and training plans.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./dist/plugin/index.js",
  "types": "./dist/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./application/ports": {
      "types": "./dist/application/ports.d.ts",
      "default": "./dist/application/ports.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "cordis.patch.yml",
    "docs/manual-import.md",
    "docs/reports/stage-05-acceptance.md",
    "docs/architecture.md",
    "docs/handoffs/v1.md",
    "benchmarks/*.json",
    "docs/reports/stage-06-bank-navigation.md",
    "docs/reports/stage-07a-bank-sorting.md",
    "docs/reports/stage-07b-training-statistics.md",
    "docs/reports/stage-07-acceptance.md",
    "docs/merged-bank.md",
    "docs/reports/stage-08a-account-guidance.md",
    "docs/reports/stage-08b-merged-bank-backend.md",
    "docs/reports/stage-08c-merged-bank-ui.md",
    "docs/reports/stage-08-acceptance.md",
    "docs/knowledge-learning.md",
    "docs/reports/stage-09a-knowledge.md",
    "docs/reports/stage-09b-knowledge-ui.md",
    "docs/reports/stage-09-acceptance.md",
    "docs/tag-alignment.md",
    "docs/reports/stage-10-tag-alignment.md",
    "docs/reports/stage-10-acceptance.md",
    "docs/reports/stage-11a-ability.md",
    "docs/reports/stage-11b-completeness.md",
    "docs/completeness-review.md",
    "docs/ai-training-plans.md",
    "docs/reports/stage-11c-ai-plans.md",
    "docs/reports/stage-11d-planning-host.md",
    "docs/reports/stage-11e-planning-ui.md",
    "docs/reports/stage-11-acceptance.md",
    "docs/user-provided-answers.md",
    "docs/flash-only-policy.md",
    "docs/reports/stage-12-user-answers.md",
    "docs/reports/stage-12-acceptance.md",
    "docs/knowledge-difficulty.md",
    "docs/reports/stage-13-acceptance.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --import ./tests/loader.mjs --test --experimental-test-isolation=none \"tests/**/*.test.ts\"",
    "build": "node scripts/build.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run typecheck && npm run check:architecture && npm run test && node --test --experimental-test-isolation=none scripts/usage.test.mjs scripts/worker-context.test.mjs && npm run build && node scripts/check-client.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@rollup/wasm-node": "4.63.1",
    "@types/node": "^24.3.0",
    "@types/react": "18.3.1",
    "react": "18.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "csv-parse": "7.0.2",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "htmlparser2": "12.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "react": "18.3.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2"
  }
}
