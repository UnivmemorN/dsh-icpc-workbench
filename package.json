{
  "name": "dsh-icpc-workbench",
  "version": "0.1.22",
  "description": "Personal ICPC training workbench plugin: normalized problems, evidence-checked tag analysis, weakness statistics and training plans.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./dist/plugin/index.js",
  "types": "./dist/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./application/ports": {
      "types": "./dist/application/ports.d.ts",
      "default": "./dist/application/ports.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "cordis.patch.yml",
    "benchmarks/*.json",
    "docs/README.md",
    "docs/user"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --import ./tests/loader.mjs --test --experimental-test-isolation=none \"tests/**/*.test.ts\"",
    "build": "node scripts/build.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check": "npm run typecheck && npm run check:architecture && npm run test && node --test --experimental-test-isolation=none scripts/usage.test.mjs scripts/worker-context.test.mjs scripts/patch-balance-client.test.mjs && npm run build && node scripts/check-client.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/wasm-node": "4.63.1",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^24.3.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.7",
    "postcss": "8.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "csv-parse": "7.0.2",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "highlight.js": "11.12.0",
    "htmlparser2": "12.0.0",
    "katex": "0.16.47",
    "lowlight": "3.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "unist-util-visit": "5.1.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-connection": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-rc.2",
    "react": "18.3.1"
  }
}
